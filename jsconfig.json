{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",

    "allowJs": true,
    "checkJs": false,

    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,

    "jsx": "preserve",
    "incremental": true
  }
}
